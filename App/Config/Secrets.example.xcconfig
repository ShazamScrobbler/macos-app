// Copy to Secrets.xcconfig (gitignored) for local builds.
// Without a Last.fm key the "ShazamScrobbler's key" option is hidden; users bring their own.
LASTFM_API_KEY = your_lastfm_api_key
LASTFM_API_SECRET = your_lastfm_api_secret
SPARKLE_PUBLIC_KEY =

// Sign local builds with the same self-signed identity as releases (scripts/make-signing-cert.sh)
// so Full Disk Access survives rebuilds. Ad-hoc ("-") builds lose it on every build.
// CODE_SIGN_IDENTITY = ShazamScrobbler Signing
